{
  "name": "omnivision",
  "version": "1.0.0",
  "description": "Universal MCP vision server for analyzing images with any LLM (OpenRouter, OpenAI, Anthropic, Google Gemini, Ollama)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "omnivision": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vision",
    "llm",
    "multimodal",
    "openai",
    "anthropic",
    "gemini"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/google": "^4.0.47",
    "@ai-sdk/openai": "^4.0.44",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.70",
    "dotenv": "^17.4.2",
    "mime-types": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
